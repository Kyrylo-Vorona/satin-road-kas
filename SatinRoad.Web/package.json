{
  "name": "satin-road-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "api:generate": "bun --bun swagger-typescript-api generate --path http://localhost:5118/openapi/v1.json --output ./src/generated --name Api.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
